# Database Credentials
MYSQL_HOST=mysql         # Change this to your docker-compose service name (e.g., 'mysql', 'db', or 'localhost' if running outside docker)
MYSQL_PORT=3306
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=userpassword

# Backend Configuration
BACKEND_PORT=5000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
 
JWT_SECRET=your_super_secret_key